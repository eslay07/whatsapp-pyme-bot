# Aplicación
ENVIRONMENT=development
DATABASE_URL=sqlite:///./whatsapp_bot.db
ADMIN_SECRET_KEY=cambia-esta-clave-administrativa
ENCRYPTION_KEY=

# Verificación de Meta
